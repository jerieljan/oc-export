// Example configuration file for oc-export.
// Copy this file to ~/.config/oc-export/config.jsonc and edit it to suit
// your preferences. oc-export reads that file automatically if it exists.
//
// CLI flags always override config values. Config values override built-in
// defaults. Missing config files are ignored. Malformed config files are
// fatal errors with a clear message.

{
  "$schema": "./schemas/config-schema.json",

  // Skip sanitization by default. When true, oc-export behaves as if --raw
  // was passed unless you explicitly use --no-raw on the command line.
  "raw": false,

  // Default session source. Valid values are "opencode" and "claude".
  // Can be overridden with --extractor on the command line.
  "extractor": "opencode",

  // Display name used on the user-turn badge in exported HTML. When set,
  // the badge text is rendered in uppercase via CSS.
  // "username": "John Doe",

  // Options for the interactive session picker and --session lookups.
  "picker": {
    // Path to the local Opencode SQLite database. The ~ prefix is expanded
    // to your home directory.
    "databasePath": "~/.local/share/opencode/opencode.db",

    // Number of recent sessions shown in the interactive picker.
    "limit": 20
  },

  // Options for the Claude Code source.
  "claude": {
    // Path to the Claude Code projects directory.
    "projectsPath": "~/.claude/projects",

    // Number of recent Claude sessions shown in the interactive picker.
    "limit": 50
  },

  // Summarization replaces thinking and tool-call blocks with short summaries
  // generated by Simon Willison's `llm` CLI. The model ID must be configured
  // here; it cannot be supplied on the command line.
  "summarize": {
    // Master switch. When false, --summarize is rejected and `always` is ignored.
    "enabled": false,

    // Model ID to pass to `llm -m`. Required when summarization is active.
    "model": "gpt-4o-mini",

    // When true, summarization runs by default without passing --summarize.
    "always": false,

    // Optional custom prompt. If omitted, type-specific defaults are used.
    // "prompt": "..."

    // Optional custom prompt for thinking summaries. Takes precedence over prompt.
    // "thinkingPrompt": "..."

    // Optional custom prompt for tool-call summaries. Takes precedence over prompt.
    // "toolsPrompt": "..."

    // Optional session-wide summary. When enabled, a "Session summary" panel is
    // added at the top of the HTML after all per-turn summaries are complete.
    "sessionSummary": {
      "enabled": false

      // Optional custom prompt for the session summary.
      // "prompt": "..."
    }
  },

  // Navigation bar shown at the bottom of exported HTML pages. It shows a
  // scrollable row of pills, one per turn, and highlights the turn currently
  // in view.
  "navigation": {
    // Master switch. When false, the bottom navigation bar is never rendered.
    "enabled": true,

    // Only show the bar when the session has at least this many turns.
    // A value of 0 means the bar is always shown.
    "minTurns": 0,

    // Show a thin progress line at the top of the bar.
    "progressBar": true,

    // Color pills by role: darker for user turns, lighter for assistant turns.
    "roleColor": true
  }
}
