{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "oc-export extended JSON session inventory",
  "description": "Extended JSON session inventory. Extra properties are allowed for additive extensions. See README for semantic invariants and compatibility policy.",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "extractor": {
      "type": "string"
    },
    "scope": {
      "type": "object",
      "properties": {
        "store_id": {
          "type": "string"
        },
        "roots": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "role": {
                "type": "string"
              },
              "path": {
                "type": "string"
              },
              "normalized_path": {
                "type": "string"
              }
            },
            "required": ["role", "path", "normalized_path"],
            "additionalProperties": true
          }
        },
        "started_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "finished_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "archive_policy": {
          "enum": ["include_archive_root", "include_archived_rows", "no_separate_archive_scan"]
        },
        "follows_index_paths": {
          "type": "boolean"
        }
      },
      "required": [
        "store_id",
        "roots",
        "started_at",
        "finished_at",
        "archive_policy",
        "follows_index_paths"
      ],
      "additionalProperties": true
    },
    "coverage": {
      "type": "object",
      "properties": {
        "effective_limit": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "directory": {
          "type": ["string", "null"]
        },
        "discovered_sessions": {
          "type": "integer",
          "minimum": 0
        },
        "matched_sessions": {
          "type": "integer",
          "minimum": 0
        },
        "returned_sessions": {
          "type": "integer",
          "minimum": 0
        },
        "truncated": {
          "type": "boolean"
        },
        "scan_complete": {
          "type": "boolean"
        },
        "status": {
          "enum": ["complete", "partial", "unavailable"]
        }
      },
      "required": [
        "effective_limit",
        "directory",
        "discovered_sessions",
        "matched_sessions",
        "returned_sessions",
        "truncated",
        "scan_complete",
        "status"
      ],
      "additionalProperties": true
    },
    "warnings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/warning"
      }
    },
    "sessions": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/session"
      }
    }
  },
  "required": ["schema_version", "extractor", "scope", "coverage", "warnings", "sessions"],
  "additionalProperties": true,
  "$defs": {
    "session": {
      "type": "object",
      "properties": {
        "extraction_status": {
          "enum": ["complete", "partial", "metadata_only"]
        },
        "last_observed_activity_at": {
          "type": ["string", "null"],
          "format": "date-time",
          "pattern": "Z$"
        },
        "export_session_id": {
          "type": ["string", "null"]
        },
        "title": {
          "type": "string"
        },
        "title_basis": {
          "enum": ["index", "session_metadata", "first_user_message", "database", "fallback"]
        },
        "directory": {
          "type": ["string", "null"]
        },
        "directory_basis": {
          "enum": ["session_metadata", "index", "database", null]
        },
        "directory_semantics": {
          "enum": ["initial_cwd", "first_observed_cwd", "project_path", "stored_directory", null]
        },
        "last_message_at": {
          "type": ["string", "null"],
          "format": "date-time",
          "pattern": "Z$"
        },
        "last_tool_event_at": {
          "type": ["string", "null"],
          "format": "date-time",
          "pattern": "Z$"
        },
        "metadata_updated_at": {
          "type": ["string", "null"],
          "format": "date-time",
          "pattern": "Z$"
        },
        "last_activity_at": {
          "type": ["string", "null"],
          "format": "date-time",
          "pattern": "Z$"
        },
        "activity_basis": {
          "enum": ["session_event", "index_update", "database_update", "file_mtime", null]
        },
        "parent_id": {
          "type": ["string", "null"]
        },
        "fork_session_id": {
          "type": ["string", "null"]
        },
        "parent_session_path": {
          "type": ["string", "null"]
        },
        "is_subagent": {
          "type": ["boolean", "null"]
        },
        "archived": {
          "type": ["boolean", "null"]
        },
        "id": {
          "type": "string"
        },
        "extractor": {
          "type": "string"
        },
        "identity": {
          "type": "string"
        },
        "canonical_identity": {
          "type": ["string", "null"]
        },
        "parent_ref": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/reference"
            }
          ]
        },
        "fork_ref": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "$ref": "#/$defs/reference"
            }
          ]
        },
        "copies": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/copy"
          }
        }
      },
      "required": [
        "extraction_status",
        "last_observed_activity_at",
        "export_session_id",
        "title",
        "title_basis",
        "directory",
        "directory_basis",
        "directory_semantics",
        "last_message_at",
        "last_tool_event_at",
        "metadata_updated_at",
        "last_activity_at",
        "activity_basis",
        "parent_id",
        "fork_session_id",
        "parent_session_path",
        "is_subagent",
        "archived",
        "id",
        "extractor",
        "identity",
        "canonical_identity",
        "parent_ref",
        "fork_ref",
        "copies"
      ],
      "additionalProperties": true
    },
    "copy": {
      "type": "object",
      "properties": {
        "extraction_status": {
          "enum": ["complete", "partial", "metadata_only"]
        },
        "last_observed_activity_at": {
          "type": ["string", "null"],
          "format": "date-time",
          "pattern": "Z$"
        },
        "export_session_id": {
          "type": ["string", "null"]
        },
        "title": {
          "type": "string"
        },
        "title_basis": {
          "enum": ["index", "session_metadata", "first_user_message", "database", "fallback"]
        },
        "directory": {
          "type": ["string", "null"]
        },
        "directory_basis": {
          "enum": ["session_metadata", "index", "database", null]
        },
        "directory_semantics": {
          "enum": ["initial_cwd", "first_observed_cwd", "project_path", "stored_directory", null]
        },
        "last_message_at": {
          "type": ["string", "null"],
          "format": "date-time",
          "pattern": "Z$"
        },
        "last_tool_event_at": {
          "type": ["string", "null"],
          "format": "date-time",
          "pattern": "Z$"
        },
        "metadata_updated_at": {
          "type": ["string", "null"],
          "format": "date-time",
          "pattern": "Z$"
        },
        "last_activity_at": {
          "type": ["string", "null"],
          "format": "date-time",
          "pattern": "Z$"
        },
        "activity_basis": {
          "enum": ["session_event", "index_update", "database_update", "file_mtime", null]
        },
        "parent_id": {
          "type": ["string", "null"]
        },
        "fork_session_id": {
          "type": ["string", "null"]
        },
        "parent_session_path": {
          "type": ["string", "null"]
        },
        "is_subagent": {
          "type": ["boolean", "null"]
        },
        "archived": {
          "type": ["boolean", "null"]
        },
        "path": {
          "type": "string"
        }
      },
      "required": [
        "extraction_status",
        "last_observed_activity_at",
        "export_session_id",
        "title",
        "title_basis",
        "directory",
        "directory_basis",
        "directory_semantics",
        "last_message_at",
        "last_tool_event_at",
        "metadata_updated_at",
        "last_activity_at",
        "activity_basis",
        "parent_id",
        "fork_session_id",
        "parent_session_path",
        "is_subagent",
        "archived",
        "path"
      ],
      "additionalProperties": true
    },
    "warning": {
      "type": "object",
      "properties": {
        "code": {
          "type": "string"
        },
        "path": {
          "type": "string"
        },
        "session_id": {
          "type": ["string", "null"]
        },
        "session_identity": {
          "type": ["string", "null"]
        },
        "message": {
          "type": "string"
        },
        "affects_completeness": {
          "type": "boolean"
        },
        "line": {
          "type": "integer",
          "minimum": 1
        }
      },
      "required": [
        "code",
        "path",
        "session_id",
        "session_identity",
        "message",
        "affects_completeness"
      ],
      "additionalProperties": true
    },
    "reference": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "identity": {
          "type": "string"
        },
        "store_id": {
          "type": "string"
        },
        "resolved": {
          "type": "boolean"
        }
      },
      "required": ["id", "identity", "store_id", "resolved"],
      "additionalProperties": true
    }
  }
}
