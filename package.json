{
  "name": "oc-export",
  "version": "0.2.0",
  "description": "Export and render chat sessions to standalone HTML files.",
  "type": "module",
  "bin": {
    "oc-export": "dist/oc-export.js"
  },
  "main": "dist/oc-export.js",
  "exports": {
    ".": "dist/oc-export.js"
  },
  "files": [
    "dist",
    "config-example.jsonc",
    "schemas",
    "completions"
  ],
  "scripts": {
    "dev": "bun oc-export.ts",
    "build": "tsc -p tsconfig.build.json && chmod +x dist/oc-export.js",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc -p tsconfig.build.json --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "test:config-schema": "bun scripts/validate-config-schema.ts"
  },
  "keywords": [
    "opencode",
    "chat",
    "export",
    "html",
    "cli",
    "claude",
    "kagi",
    "open-webui"
  ],
  "author": "Jeriel Jan del Prado <jerieljan@gmail.com>",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jerieljan/oc-export.git"
  },
  "bugs": {
    "url": "https://github.com/jerieljan/oc-export/issues"
  },
  "homepage": "https://github.com/jerieljan/oc-export#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.9",
    "@types/better-sqlite3": "^7.6.13",
    "@types/bun": "^1.3.14",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^26.1.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "@redactpii/node": "^1.0.17",
    "better-sqlite3": "^13.0.1",
    "markdown-it": "^14.3.0",
    "strip-json-comments": "^5.0.3"
  }
}
